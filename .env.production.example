PORT=5000
NODE_ENV=production
CLIENT_URL=https://vigileye.ai
DATABASE_URL="postgresql://username:password@your-postgres-host:5432/vigileye?schema=public"
JWT_SECRET="generate-a-strong-random-secret-key-for-prod"
JWT_REFRESH_SECRET="generate-a-strong-random-refresh-secret-key-for-prod"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
EMAIL_HOST="smtp.sendgrid.net"
EMAIL_PORT=587
EMAIL_USER="apikey"
EMAIL_PASSWORD="your-sendgrid-api-key"
EMAIL_FROM="security@vigileye.ai"
