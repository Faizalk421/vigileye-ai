# Server Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database - SQLite default (zero-config) or PostgreSQL
# SQLite: file:./dev.db
# PostgreSQL: postgresql://postgres:password@localhost:5432/vigileye?schema=public
DATABASE_URL="file:./dev.db"

# JWT Secrets
JWT_SECRET="vigileye_super_secret_jwt_access_token_key_2026"
JWT_REFRESH_SECRET="vigileye_super_secret_jwt_refresh_token_key_2026"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Email Configuration (for verification and password resets - mock/smtp)
EMAIL_HOST="smtp.mailtrap.io"
EMAIL_PORT=2525
EMAIL_USER="mock_user"
EMAIL_PASSWORD="mock_password"
EMAIL_FROM="no-reply@vigileye.ai"

# Initial Admin Credentials (for seed script)
INITIAL_ADMIN_EMAIL="admin@vigileye.ai"
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD="Admin@12345!"
