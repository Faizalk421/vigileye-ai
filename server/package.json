{
  "name": "vigileye-server",
  "version": "1.0.0",
  "description": "VigilEye AI Full-Stack REST API & Authentication Server",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
